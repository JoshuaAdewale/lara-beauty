# Cloudflare Pages redirect rules (Netlify uses netlify.toml).
/admin    /admin.html   200
/api/*    /api/:splat   200
# Internal docs are not web pages — never serve them.
/*.md     /404.html     404

# Unmatched paths get a real 404, not a 200 copy of the homepage.
# Cloudflare Pages serves existing static files first, so this only catches misses.
/*        /404.html     404
