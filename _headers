# Cloudflare Pages / Netlify shared header rules.
# Netlify reads netlify.toml; Cloudflare Pages reads this file. Keeping both
# means the same folder deploys correctly to either host.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(self)
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' https://js.paystack.co 'sha256-mmqyIzZ9WxQvWNGzZ3AtYNr8qgnku4A487AJIIkF5L8='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.paystack.co; frame-src https://checkout.paystack.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'

/admin.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store, max-age=0
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-mmqyIzZ9WxQvWNGzZ3AtYNr8qgnku4A487AJIIkF5L8='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'

/admin.js
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store, max-age=0

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/api/*
  Cache-Control: no-store, max-age=0
